{
  "http-request": {
    "method": "POST",
    "path": "/orders",
    "headers": { "Content-Type": "application/json" },
    "body": { "id": "$match(pattern: ^\\d+$)", "status": "created" }
  },
  "http-response": {
    "status": 201,
    "headers": { "Content-Type": "application/json" },
    "body": { "id": 504, "status": "created" }
  }
}
